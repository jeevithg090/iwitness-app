# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS or a local Postgres).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safereport?schema=public"

# ─── Authentication (NextAuth.js) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# ─── AI image analysis (optional) ────────────────────────────────────────────
# Google Gemini API key. Without it, the form still works; photo analysis is skipped.
GEMINI_API_KEY=""
# Gemini model used to draft reports from photos.
GEMINI_MODEL="gemini-2.5-flash"

# ─── Address autocomplete (optional) ─────────────────────────────────────────
# Mapbox public access token (pk.*). Without it, the location field is a plain text input.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# ─── Seeding (optional, used by `npm run db:seed` / `npm run create-admin`) ──
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
