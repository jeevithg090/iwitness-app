generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ReportType {
  EMERGENCY
  NON_EMERGENCY
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

/// An anonymous incident report. No reporter identity is stored.
model Report {
  id          String       @id @default(cuid())
  /// Public tracking ID handed to the reporter (16 hex chars, unique).
  reportId    String       @unique
  type        ReportType
  title       String
  description String
  /// Incident category, e.g. "Theft" or "Fire Outbreak".
  reportType  String
  location    String?
  latitude    Float?
  longitude   Float?
  /// Optional photo stored as a base64 data URL.
  image       String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Staff account (ADMIN / MODERATOR) or a regular signed-up USER.
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     Role   @default(USER)
}
